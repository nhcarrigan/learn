---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allArticles = await getCollection("articles");
const sorted = allArticles.sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const categories = [
  { slug: "security", label: "Security & Safety" },
  { slug: "tools", label: "Tools & Productivity" },
  { slug: "development", label: "Development" },
  { slug: "community", label: "Community" },
  { slug: "career", label: "Career" },
  { slug: "general", label: "General" },
] as const;
---

<BaseLayout
  title="All Articles"
  description="Browse all articles and resources."
>
  <h1>All Articles</h1>

  <div class="filters">
    <button class="filter active" data-category="all">All</button>
    {
      categories.map((cat) => (
        <button class="filter" data-category={cat.slug}>
          {cat.label}
        </button>
      ))
    }
  </div>

  <ul class="article-list" id="article-list">
    {sorted.map((article) => (
      <li data-category={article.data.category}>
        <a href={`/articles/${article.id}`} class="article-card">
          <div class="article-meta">
            <span class="badge">{article.data.category}</span>
            <span class="badge">{article.data.difficulty}</span>
          </div>
          <h2>{article.data.title}</h2>
          <p>{article.data.description}</p>
          <span class="date">
            {article.data.publishedAt.toLocaleDateString("en-GB", {
              dateStyle: "medium",
            })}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="empty hidden" id="empty-state">No articles in this category yet.</p>
</BaseLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .filter {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: capitalize;
    padding: 0.35em 1em;
    border-radius: 999px;
    border: 1px solid var(--border);
    background-color: var(--bg-card);
    color: var(--text-muted);
    transition: border-color 0.15s, color 0.15s;
    cursor: pointer;
  }

  .filter:hover,
  .filter.active {
    border-color: var(--accent);
    color: var(--highlight);
    text-decoration: none;
  }

  .article-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .article-card {
    display: block;
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: border-color 0.15s;
  }

  .article-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .article-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15em 0.6em;
    color: var(--text-muted);
  }

  h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  p {
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .date {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .empty {
    color: var(--text-muted);
  }

  .hidden {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
  const items = document.querySelectorAll<HTMLLIElement>("#article-list li");
  const emptyState = document.getElementById("empty-state");

  function applyFilter(category: string): void {
    buttons.forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.category === category);
    });

    let visible = 0;
    items.forEach((item) => {
      const show = category === "all" || item.dataset.category === category;
      item.style.display = show ? "" : "none";
      if (show) { visible++; }
    });

    if (emptyState) {
      emptyState.classList.toggle("hidden", visible > 0);
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      applyFilter(btn.dataset.category ?? "all");
    });
  });

  const params = new URLSearchParams(window.location.search);
  const initial = params.get("category") ?? "all";
  applyFilter(initial);
</script>
