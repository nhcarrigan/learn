---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = await getCollection("articles");
const sorted = articles.sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const categories = [
  { slug: "security", label: "Security & Safety" },
  { slug: "tools", label: "Tools & Productivity" },
  { slug: "development", label: "Development" },
  { slug: "community", label: "Community" },
  { slug: "career", label: "Career" },
  { slug: "general", label: "General" },
] as const;
---

<BaseLayout
  title="Home"
  description="Guides, resources, and things worth knowing - from Naomi Carrigan."
>
  <section class="hero">
    <h1>NHCarrigan Academy</h1>
    <p>
      Welcome to NHCarrigan Academy. This page is a collection of various resources we've created and shared somewhere in the world. Now we collect them all here for you to find~
    </p>
  </section>

  <section class="categories">
    <h2>Browse by Topic</h2>
    <div class="category-grid">
      {
        categories.map((cat) => {
          const count = sorted.filter(
            (a) => a.data.category === cat.slug
          ).length;
          return (
            <a href={`/articles?category=${cat.slug}`} class="category-card">
              <span class="category-name">{cat.label}</span>
              <span class="category-count">
                {count} {count === 1 ? "article" : "articles"}
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="recent">
    <h2>Recent Articles</h2>
    {
      sorted.length === 0 ? (
        <p class="empty">No articles yet — check back soon!</p>
      ) : (
        <div class="article-list">
          {sorted.slice(0, 6).map((article) => (
            <div>
              <a href={`/articles/${article.id}`} class="article-card">
                <div class="article-meta">
                  <span class="badge">{article.data.category}</span>
                  <span class="badge difficulty">{article.data.difficulty}</span>
                </div>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </a>
            </div>
          ))}
        </div>
      )
    }
    {
      sorted.length > 6 && (
        <a href="/articles" class="view-all">
          View all {sorted.length} articles &rarr;
        </a>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }

  .hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 1rem;
    background: linear-gradient(
      135deg,
      var(--highlight),
      var(--accent)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero p {
    font-size: 1.125rem;
    max-width: 600px;
    margin: 0 auto;
  }

  section {
    margin-top: 3rem;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    transition: border-color 0.15s;
  }

  .category-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .category-name {
    font-weight: 600;
  }

  .category-count {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .article-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .article-card {
    display: block;
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    height: 100%;
    transition: border-color 0.15s;
  }

  .article-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .article-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15em 0.6em;
    color: var(--text-muted);
  }

  .article-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .article-card p {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .view-all {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
  }

  .empty {
    color: var(--text-muted);
  }
</style>
