---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { title, description, category, difficulty, publishedAt, updatedAt } =
  article.data;

const difficultyColour = {
  beginner: "var(--colour-success)",
  intermediate: "var(--colour-warning)",
  advanced: "var(--colour-danger)",
} as const;
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <header class="article-header">
      <div class="meta">
        <span class="badge category">{category}</span>
        <span
          class="badge difficulty"
          style={`color: ${difficultyColour[difficulty]}`}
        >
          {difficulty}
        </span>
      </div>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <p class="dates">
        Published{" "}
        <time datetime={publishedAt.toISOString()}>
          {publishedAt.toLocaleDateString("en-GB", { dateStyle: "long" })}
        </time>
        {
          updatedAt && (
            <>
              {" "}
              &middot; Updated{" "}
              <time datetime={updatedAt.toISOString()}>
                {updatedAt.toLocaleDateString("en-GB", { dateStyle: "long" })}
              </time>
            </>
          )
        }
      </p>
    </header>

    <div class="article-body">
      <slot />
    </div>

    <footer class="article-footer">
      <a href="/">&larr; Back to home</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 800px;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2em 0.75em;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .dates {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .article-body :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-body :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .article-body :global(p) {
    margin-bottom: 1rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.25rem;
  }

  .article-body :global(blockquote) {
    border-left: 4px solid var(--border);
    padding-left: 1rem;
    margin-left: 0;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 1rem;
  }

  .article-body :global(.callout) {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }

  .article-body :global(.callout.warning) {
    border-color: var(--colour-warning);
  }

  .article-body :global(.callout.danger) {
    border-color: var(--colour-danger);
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
